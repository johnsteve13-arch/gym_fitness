# Server Configuration
PORT=5000
NODE_ENV=development

# TiDB Cloud / MySQL Database Connection URL
# Example for TiDB Serverless:
# DATABASE_URL="mysql://<user>.<prefix>:<password>@<host>:4000/<database>?sslaccept=strict"
DATABASE_URL="mysql://root:password@localhost:3306/gym_fitness"

# Authentication & Security
JWT_SECRET="your-ultra-secure-jwt-secret-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000,https://gym-fitness.vercel.app"
FRONTEND_URL="http://localhost:3000"

# Auto-cancellation & System Timers (Minutes)
UNPAID_BOOKING_TIMEOUT_MINUTES=30
